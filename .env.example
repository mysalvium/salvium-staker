# Copy this file to .env. The real .env is ignored by Git.
# This file contains settings only; passwords belong in ./secrets files.
STACK_DIR=/mnt/sharedrive/salvium-private/staker
SALVIUM_VERSION=v1.1.3c
STACK_RELEASE=2.2.1

# Server-side wallets reach the companion node through its private Docker
# network. Keep these defaults when salvium-node-p2pool runs on the same host.
# Never publish or forward the elevated 19081 RPC port.
PRIVILEGED_RPC_NETWORK=salvium_privileged_rpc
DAEMON_ADDRESS=salviumd:19081

RPC_USER=sal_rpc
PUBLIC_WALLET_FILE=Public Salvium Wallet
MINER_WALLET_FILE=Salvium Miner Wallet
POLL_INTERVAL_SECONDS=600
BALANCE_LOG_INTERVAL=600
WALLET_LOG_LEVEL=1
HEALTH_MAX_AGE_SECONDS=1800

# Safe default: observe balances and decisions, but do not make transactions.
ENABLE_CONSOLIDATION=false
ENABLE_STAKING=false
